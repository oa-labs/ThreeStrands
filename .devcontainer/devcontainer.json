{
  "name": "ThreeStrands Linux build",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "options": ["--platform=linux/amd64"]
  },
  "runArgs": ["--platform=linux/amd64"],
  "remoteUser": "vscode",
  "mounts": [
    "source=threestrands-linux-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=threestrands-linux-cargo-target,target=${containerWorkspaceFolder}/src-tauri/target,type=volume"
  ],
  "containerEnv": {
    "APPIMAGE_EXTRACT_AND_RUN": "1"
  },
  "postCreateCommand": "sudo chown -R vscode:vscode node_modules src-tauri/target && pnpm install --frozen-lockfile",
  "forwardPorts": [1420],
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tauri-apps.tauri-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
