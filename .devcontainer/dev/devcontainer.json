{
  "name": "ThreeStrands development",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../..",
    "args": {
      "INSTALL_SUPPLY_CHAIN_TOOLS": "1"
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=threestrands-dev-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=threestrands-dev-cargo-target,target=${containerWorkspaceFolder}/target,type=volume",
    "source=threestrands-dev-tauri-target,target=${containerWorkspaceFolder}/src-tauri/target,type=volume",
    "source=threestrands-dev-cargo-registry,target=/home/vscode/.cargo/registry,type=volume",
    "source=threestrands-dev-claude,target=/home/vscode/.claude,type=volume",
    "source=threestrands-dev-codex,target=/home/vscode/.codex,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "postCreateCommand": "sudo chown -R vscode:vscode node_modules target src-tauri/target /home/vscode/.cargo/registry /home/vscode/.claude /home/vscode/.codex &&pnpm install --frozen-lockfile && pnpm exec playwright install --with-deps chromium webkit",
  "forwardPorts": [1420],
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tauri-apps.tauri-vscode",
        "dbaeumer.vscode-eslint",
        "anthropic.claude-code",
        "openai.chatgpt"
      ]
    }
  }
}
