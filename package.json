{
  "name": "threestrands",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.83.2",
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "tsc --noEmit -p site && vite build --config site/vite.config.ts",
    "site:images": "node site/scripts/optimize-screenshots.mjs",
    "site:og": "node site/scripts/render-og.mjs",
    "test:site": "node --test site/scripts/optimize-screenshots.test.mjs && tsc --noEmit -p site && playwright test --config playwright.site.config.ts",
    "build:linux": "./scripts/build-linux.sh",
    "release": "node scripts/release.mjs tag",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.52.0",
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "sharp": "^0.35.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
