{
  "insert": [
    {
      "name": "empty note",
      "body": "",
      "expected": "## Meetings\n\n- NEW\n"
    },
    {
      "name": "text without a final newline",
      "body": "Hello",
      "expected": "Hello\n\n## Meetings\n\n- NEW\n"
    },
    {
      "name": "text with a final newline",
      "body": "Hello\n",
      "expected": "Hello\n\n## Meetings\n\n- NEW\n"
    },
    {
      "name": "text ending in a blank line",
      "body": "Hello\n\n",
      "expected": "Hello\n\n## Meetings\n\n- NEW\n"
    },
    {
      "name": "section in the middle",
      "body": "# Day\n\n## Meetings\n\n- 9am A\n\n## Tasks\n\n- ( ) x\n",
      "expected": "# Day\n\n## Meetings\n\n- 9am A\n- NEW\n\n## Tasks\n\n- ( ) x\n"
    },
    {
      "name": "section at the end without a final newline",
      "body": "## Meetings\n- A",
      "expected": "## Meetings\n- A\n- NEW\n"
    },
    {
      "name": "empty section",
      "body": "## Meetings\n\n## Tasks\n",
      "expected": "## Meetings\n\n- NEW\n\n## Tasks\n"
    },
    {
      "name": "heading matched by normalized text with a closing run",
      "body": "##   meetings  ##\n- A\n",
      "expected": "##   meetings  ##\n- A\n- NEW\n"
    },
    {
      "name": "a deeper heading stays in the section",
      "body": "## Meetings\n- A\n### Notes\nText\n## Next\n",
      "expected": "## Meetings\n- A\n### Notes\nText\n- NEW\n## Next\n"
    },
    {
      "name": "a heading inside code is not the section",
      "body": "```\n## Meetings\n```\n",
      "expected": "```\n## Meetings\n```\n\n## Meetings\n\n- NEW\n"
    },
    {
      "name": "closed code inside the section",
      "body": "## Meetings\n```\n## not a heading\n```\n\nAfter\n",
      "expected": "## Meetings\n```\n## not a heading\n```\n\nAfter\n- NEW\n"
    },
    {
      "name": "first of two sections",
      "body": "## Meetings\n- A\n## Meetings\n- B\n",
      "expected": "## Meetings\n- A\n- NEW\n## Meetings\n- B\n"
    },
    {
      "name": "trailing blank lines stay after the line",
      "body": "## Meetings\n- A\n\n\n",
      "expected": "## Meetings\n- A\n- NEW\n\n\n"
    },
    {
      "name": "a level-1 heading is not the section",
      "body": "# Meetings\n- A\n",
      "expected": "# Meetings\n- A\n\n## Meetings\n\n- NEW\n"
    },
    {
      "name": "other heading text is not the section",
      "body": "## Meetings later\n",
      "expected": "## Meetings later\n\n## Meetings\n\n- NEW\n"
    },
    {
      "name": "no space after the hashes is not a heading",
      "body": "##Meetings\n",
      "expected": "##Meetings\n\n## Meetings\n\n- NEW\n"
    },
    {
      "name": "an indented heading is code",
      "body": "    ## Meetings\n",
      "expected": "    ## Meetings\n\n## Meetings\n\n- NEW\n"
    },
    {
      "name": "unclosed code at the end",
      "body": "Text\n```\ncode\n",
      "expected": null
    },
    {
      "name": "unclosed code in the section",
      "body": "## Meetings\n- A\n~~~\ncode\n",
      "expected": null
    },
    {
      "name": "a shorter run doesn't close code",
      "body": "## Meetings\n````\n```\n",
      "expected": null
    }
  ],
