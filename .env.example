# Public OAuth client ID for a Google Cloud OAuth client of type "Desktop app".
# This is an identifier, not a client secret.
THREESTRANDS_GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
# Google calls this a client secret, but Desktop apps are public clients and
# cannot keep it confidential. Never put a real value in a committed file.
THREESTRANDS_GOOGLE_CLIENT_SECRET=
