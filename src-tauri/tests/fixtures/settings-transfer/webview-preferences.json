{
  "theme": "dark",
  "accent": "teal",
  "fontScale": 120,
  "fontFamily": "Georgia",
  "autoReadDelaySeconds": 8,
  "loadRemoteImages": true,
  "selectedAccountId": "person@example.com",
  "aiProvider": "openrouter",
  "aiModel": "example/model",
  "aiFastModel": "example/fast-model",
  "aiEndpoint": "https://api.example.test/v1",
  "aiFeatures": {
    "draftAssist": true,
    "summarize": true,
    "actionExtraction": true,
    "contactEnrichment": true,
    "proactiveBriefs": true,
    "proactiveKnownSendersOnly": true,
    "threadChat": true
  },
  "availabilityPreferences": {
    "timeZone": "America/New_York",
    "workingWindows": [
      {
        "weekday": 1,
        "start": "09:00",
        "end": "17:00"
      },
      {
        "weekday": 5,
        "start": "10:00",
        "end": "15:00"
      }
    ],
    "defaultDurationMinutes": 30,
    "slotIncrementMinutes": 15
  },
  "emailMinimumFontSize": 18
}
