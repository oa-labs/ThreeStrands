<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Code-signing entitlements for the macOS bundle (tauri.conf.json
     bundle.macOS.entitlements). The hardened runtime blocks microphone input
     unless the app declares it; Meeting Recording needs it. System audio
     comes from a Core Audio process tap, which needs no entitlement (its
     prompt text is NSAudioCaptureUsageDescription in Info.plist). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
