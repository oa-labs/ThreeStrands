  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFQkQ2N0M0QjZCMzE0NzIKUldSeUZMTzJ4R2U5amdxb1dRUWNYTVJKLzRCaW12OGlIM1Mvdi80eTVjbWxUZ1RUVERVUkJyblYK",
